PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development

# What this machine is: "api" (default) or "kiosk".
#
# A kiosk is one screen in one family's home. It pre-downloads that family's
# photographs so the display keeps working with no internet.
#
# An api serves every family and pre-downloads nothing — otherwise every
# replica ends up holding a copy of every customer's private media.
RECALL_ROLE=api
# Required when RECALL_ROLE=kiosk. Which family this screen belongs to.
RECALL_KIOSK_ARCHIVE_ID=

# Supabase project settings -> API
SUPABASE_URL=
# The "secret" / service_role key. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Signs admin session cookies. Must be at least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Email (Nodemailer / Gmail). Must be a 16-character Gmail App Password.
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Recall <you@example.com>"

# Keys the invitation and verification code lookups (M16). Required.
# Generate with: openssl rand -hex 32
CODE_PEPPER=
